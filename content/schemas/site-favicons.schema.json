{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elixpo.com/schemas/site-favicons.schema.json",
  "title": "Elixpo deployed-site favicons",
  "description": "Generated by scripts/sync-site-favicons.py from each directory entry's live website; do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "lastVerified", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "lastVerified": { "type": "string", "format": "date" },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "source"],
        "properties": {
          "path": { "type": "string", "pattern": "^/brand/favicons/[A-Za-z0-9._-]+\\.webp$" },
          "source": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    }
  }
}
